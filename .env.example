# Optional override for the Vercel Connect Google connector UID.
# Create/link the connector as google/jarvis-gmail in the connected Vercel project.
GOOGLE_CONNECTOR_UID=google/jarvis-gmail

# Neon Postgres connection string (provided by the Vercel Marketplace integration).
DATABASE_URL=

# WhatsApp Business Cloud credentials for outbound alerts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_ID=
WHATSAPP_GRAPH_API_VERSION=v27.0

# An approved Meta message template with a single body placeholder, such as {{1}}.
WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=
